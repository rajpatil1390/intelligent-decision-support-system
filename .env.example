# Copy this file to .env and fill in your values. Never commit .env.

# Provider: openai | groq | gemini | ollama
LLM_PROVIDER=openai

# Model name as listed by your provider (check the provider's current model list).
LLM_MODEL=

# API key for the provider. Leave empty for ollama.
LLM_API_KEY=

# Optional. Leave empty to use the provider's default OpenAI-compatible URL:
#   openai -> https://api.openai.com/v1
#   groq   -> https://api.groq.com/openai/v1
#   gemini -> https://generativelanguage.googleapis.com/v1beta/openai/
#   ollama -> http://localhost:11434/v1
LLM_BASE_URL=

# Seconds before an LLM call is aborted.
LLM_TIMEOUT=60

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Optional web search for the knowledge agent (leave empty to use only the local knowledge base).
# When set, short search queries describing the task are sent to that provider.
TAVILY_API_KEY=
SERPAPI_KEY=

# Public demo (hosted, shared instance): 1 = Ask Your Data off (it runs generated code), uploads <= 10 MB,
# fast budget only, runs older than 24 h deleted at API startup, "do not upload private data" banner in the UI.
# Default 0 (off) for local use.
IDSS_PUBLIC_DEMO=0

# Streamlit UI only, read from the shell environment (NOT from this file): where the UI finds the API.
# Default http://localhost:8000; scripts\run_ui.ps1 -ApiUrl <url> sets it for you.
# IDSS_API_URL=http://localhost:8000
