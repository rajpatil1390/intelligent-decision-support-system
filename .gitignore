.venv/
# Any .env variant may hold secrets; only the documented template is tracked.
.env*
!.env.example
# Streamlit secrets (local tests of the Community Cloud setup; on the cloud they live in the app's settings)
.streamlit/secrets.toml
__pycache__/
*.db
*.db-wal
*.db-shm
# Run outputs, logs, uploads, the database and the index cache; only the two .gitkeep files are tracked.
workspace/*
!workspace/runs/
!workspace/logs/
workspace/runs/*
workspace/logs/*
!workspace/runs/.gitkeep
!workspace/logs/.gitkeep
reference/
.coverage
htmlcov/
.pytest_cache/
.ruff_cache/
# slide PNGs rendered by scripts/build_ppt.py / build_ppt_v2.py for visual QA
docs/presentation/slides/
# college report/slide templates and the one-page layout reference (inputs of the build scripts), not committed
docs/format/
playground/
# Office lock files (a document open in Word/PowerPoint)
~$*
# Local tool and editor settings, not part of the project
CLAUDE.md
.claude/
*.local.json
# Generated college deliverables with personal details; rebuild them locally with the scripts/build_*.py tools
docs/report/final/*.docx
docs/report/final/*.pdf
docs/presentation/*.pptx
docs/presentation/IDSS_Presentation*.pdf
docs/report_latex/IDSS_Report_Overleaf.zip
